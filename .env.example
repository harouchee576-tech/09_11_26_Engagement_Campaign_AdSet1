# ==============================================================================
# HAROU GENERATOR 2.0 — Configuration 100% Optionnelle (API Publique & Open-Source)
# ==============================================================================
# Aucune variable n'est obligatoire pour démarrer HAROU GENERATOR 2.0.
# Si un service externe n'est pas configuré, le moteur bascule automatiquement
# vers une alternative open-source ou gratuite disponible.

# --- 0. Déploiement Public & Sécurité API (Optionnels) ---
PORT="3000"
HOST="0.0.0.0"

# URL publique stable de votre serveur (ex: https://api.harougenerator.com)
PUBLIC_API_URL=""
APP_URL=""

# Clé API maître statique côté serveur (recommandé en conteneur Cloud Run / Render / Railway)
# Vous pouvez aussi générer des clés dynamiques depuis l'interface web (/api/v1/keys).
HAROU_API_KEY=""
HAROU_API_KEYS=""

# Secret HMAC pour cookies de session studio et URLs média signées (min 32 caractères)
HAROU_SESSION_SECRET=""

# Origines autorisées pour Lovable / HAROU AI (vide ou * = toutes, ou liste CSV avec jokers ex: https://*.lovable.app,https://harou-ai.com)
CORS_ALLOWED_ORIGINS=""

# Limite de requêtes par minute et par clé/IP
RATE_LIMIT_RPM="180"

# Dossiers persistants optionnels (utile pour disque monté Cloud / Render / Railway)
HAROU_DATA_DIR=""
HAROU_STORAGE_DIR=""

# --- 1. LLM Scénarios & Personnages (Optionnels) ---
# Ollama local open-source (par défaut détecté sur http://127.0.0.1:11434)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"

# Hugging Face Inference gratuit (optionnel)
HF_TOKEN=""

# Gemini Free Tier (optionnel — injecté automatiquement dans AI Studio)
GEMINI_API_KEY=""

# --- 2. Génération d'Images Open-Source (Optionnels) ---
# ComfyUI local (par défaut détecté sur http://127.0.0.1:8188)
COMFYUI_URL=""
COMFYUI_CHECKPOINT="v1-5-pruned-emaonly.safetensors"

# Stable Diffusion WebUI / Forge local (par défaut détecté sur http://127.0.0.1:7860)
SD_WEBUI_URL=""

# --- 3. Synthèse Vocale Open-Source (Optionnels) ---
# Piper TTS neuronal hors-ligne (binaire + modèle .onnx)
PIPER_BIN=""
PIPER_MODEL=""

# eSpeak-NG local (auto-détecté dans PATH si installé)
ESPEAK_BIN=""
